# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# Projects are tracked; ignore Godot caches and exports
projects/*/source/**/.godot/
projects/*/source/**/.import/
projects/*/builds/**/*.pck
projects/*/builds/**/*.wasm

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.log
.cache/

# Environment variables
.env
.env.local

# Claude specific (studio subagents + CLAUDE.md are tracked)
.claude/*
!.claude/agents/
.claude/settings.local.json

# Backup files
*.backup
*.bak
*~

# Archive (old versions)
archive/

# Build outputs
dist/
build/
*.egg-info/