{
  "name": "warbuilder",
  "version": "0.1.0",
  "private": true,
  "description": "Warzone Deckbuilder: HTML5 single-file game, rules engine, print-and-play generator.",
  "license": "UNLICENSED",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node tools/build.js",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "test:update-golden": "UPDATE_GOLDEN=1 node --test test/determinism.test.js",
    "sim": "node tools/balance.js",
    "pnp": "node tools/pnp.js",
    "pnp:pdf": "node tools/pnp.js --pdf"
  }
}
