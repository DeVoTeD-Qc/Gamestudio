# card_art.gd
# Purpose: Original vector art for cards, board tokens, lane backdrops and the Title key art (v01).
#   The art is SVG text in card_art_data.gd (generated by tests/tools/gen_card_art.py). It is
#   rasterised here at runtime with Image.load_svg_from_string() at the size it is shown, so it is
#   crisp on a 3x phone without shipping big bitmaps (the whole set is ~330 KB of text).
#   Textures are cached per (key, scale bucket). Rasterising one card takes a few ms.
# Usage:
#   CardArt.card_texture(CardArt.card_key(view_dict), 2.0)   # CardView art window
#   CardArt.token_texture(&"sniper", 1.5)                     # unit slot silhouette (white, tint it)
#   CardArt.lane_texture(&"cranes", 1.5)                      # board lane backdrop
#   CardArt.key_art_texture(1.0)                              # Title background
# Dependencies: card_art_data.gd
# Author: Sr Game Artist Agent (v01)
class_name CardArt
extends RefCounted

const Data: GDScript = preload("res://scripts/ui/art/card_art_data.gd")
const MAX_CACHE: int = 64
## Killstreak / type / weapon class -> art key fallbacks are in Data.ALIASES.
const OPERATOR_ART: Dictionary = {&"ar": &"kestrel_ar7", &"smg": &"wasp_9", &"sniper": &"longreach_338"}
## Unit slot class word (unit_slot.gd) -> token silhouette.
const TOKEN_FOR_CLASS: Dictionary = {
	"AR": &"ar", "SMG": &"smg", "SHOTGUN": &"shotgun", "SNIPER": &"sniper", "LMG": &"lmg",
	"OPERATOR": &"operator", "": &"shield",
}

static var _cache: Dictionary = {}
static var _order: Array = []


## Art key for a CardView dictionary: the card id, else its art_icon, else its weapon class / type.
static func card_key(d: Dictionary) -> StringName:
	var type_name: String = String(d.get("type", "unit"))
	var weapon: String = String(d.get("weapon_class", "")).to_lower()
	if type_name == "operator":
		return OPERATOR_ART.get(StringName(weapon), &"type_operator")
	for k: String in [String(d.get("id", "")), String(d.get("art_icon", ""))]:
		if k != "" and has_card(StringName(k)):
			return StringName(k)
	if weapon != "" and has_card(StringName("class_" + weapon)):
		return StringName("class_" + weapon)
	return StringName("type_" + type_name)


static func has_card(key: StringName) -> bool:
	return Data.CARDS.has(key) or Data.ALIASES.has(key)


static func card_texture(key: StringName, scale: float) -> Texture2D:
	key = Data.ALIASES.get(key, key)
	if not Data.CARDS.has(key):
		return null
	return _raster("card/" + String(key), Data.CARDS[key], scale)


static func token_texture(key: StringName, scale: float) -> Texture2D:
	if not Data.TOKENS.has(key):
		return null
	return _raster("token/" + String(key), Data.TOKENS[key], scale)


## Lane backdrop for a zone name ("CONTAINER STACKS", "CRANE YARD", "LOADING OFFICES"...).
static func lane_key(zone_name: String, zone_id: StringName) -> StringName:
	var n: String = zone_name.to_upper()
	if "CONTAINER" in n or "STACK" in n:
		return &"containers"
	if "CRANE" in n or "YARD" in n:
		return &"cranes"
	if "OFFICE" in n or "LOADING" in n:
		return &"offices"
	return {&"left": &"containers", &"mid": &"cranes", &"right": &"offices"}.get(zone_id, &"containers")


static func lane_texture(key: StringName, scale: float) -> Texture2D:
	if not Data.LANES.has(key):
		return null
	return _raster("lane/" + String(key), Data.LANES[key], scale)


static func key_art_texture(scale: float) -> Texture2D:
	return _raster("key", Data.KEY_ART, scale)


## Scale bucket: steps of 0.5 from 0.5 to 4, so a resize doesn't re-rasterise every frame.
static func bucket(scale: float) -> float:
	return clampf(ceilf(scale * 2.0) / 2.0, 0.5, 4.0)


static func _raster(name: String, svg_text: String, scale: float) -> Texture2D:
	var s: float = bucket(scale)
	var cache_key: String = "%s@%.1f" % [name, s]
	if _cache.has(cache_key):
		return _cache[cache_key]
	var img := Image.new()
	if img.load_svg_from_string(svg_text, s) != OK:
		push_warning("CardArt: could not rasterise %s" % name)
		return null
	var tex: ImageTexture = ImageTexture.create_from_image(img)
	_cache[cache_key] = tex
	_order.append(cache_key)
	while _order.size() > MAX_CACHE:
		_cache.erase(_order.pop_front())
	return tex


## Effective on-screen pixels per canvas unit for a CanvasItem (canvas scale x screen scale).
static func screen_scale(item: CanvasItem) -> float:
	if item == null or not item.is_inside_tree():
		return 1.0
	var xf: Transform2D = item.get_viewport().get_screen_transform() * item.get_global_transform_with_canvas()
	return maxf(absf(xf.get_scale().x), absf(xf.get_scale().y))
