# art_icons.gd
# Purpose: Runtime access to the original Banner Wall icons (cc14): 6 trait icons, 4 cipher glyphs,
#   6 set glyphs and utility marks (eye_open, lock, capture_arrow, signature). The SVG text lives in
#   art_icon_data.gd (generated by tests/tools/gen_art_icons.py, which also writes assets/icons/*.svg).
#   Icons are white; tint them with modulate / draw_texture_rect(..., modulate).
#   They are rasterised at the pixel size they are shown (bucketed), so they are crisp at 3x.
# Usage:
#   ArtIcons.get_icon(&"trait_ambush", 40)        # Texture2D about 40 px square
#   ArtIcons.trait_icon(&"veteran", 24)
#   ArtIcons.cipher_glyph(2, 64)                   # glyph 1-4 for the Cipher Lock dials
#   ArtIcons.NAMES                                  # every icon id
# Dependencies: art_icon_data.gd
# Author: Technical Artist Agent (cc14)
class_name ArtIcons
extends RefCounted

const Data: GDScript = preload("res://scripts/art/art_icon_data.gd")
const MAX_CACHE: int = 96

static var _cache: Dictionary = {}
static var _order: Array = []


static func names() -> Array:
	return Data.ICONS.keys()


static func has_icon(icon: StringName) -> bool:
	return Data.ICONS.has(icon)


static func trait_icon(trait_id: StringName, px: float) -> Texture2D:
	return get_icon(StringName("trait_" + String(trait_id)), px)


static func set_icon(set_id: StringName, px: float) -> Texture2D:
	return get_icon(StringName("set_" + String(set_id)), px)


## Cipher glyph 1-4 (spec 5: the four glyphs hidden in cards 1, 5, 9 and 13).
static func cipher_glyph(index: int, px: float) -> Texture2D:
	return get_icon(StringName("cipher_%d" % clampi(index, 1, 4)), px)


## Rasterised icon about px pixels square (rounded up to a bucket of 8 px, min 16, max 256).
static func get_icon(icon: StringName, px: float) -> Texture2D:
	if not Data.ICONS.has(icon):
		return null
	var size: int = clampi(int(ceilf(px / 8.0)) * 8, 16, 256)
	var key: String = "%s@%d" % [icon, size]
	if _cache.has(key):
		return _cache[key]
	var img := Image.new()
	if img.load_svg_from_string(Data.ICONS[icon], float(size) / float(Data.SIZE)) != OK:
		push_warning("ArtIcons: could not rasterise %s" % icon)
		return null
	img.generate_mipmaps()
	var tex := ImageTexture.create_from_image(img)
	_cache[key] = tex
	_order.append(key)
	while _order.size() > MAX_CACHE:
		_cache.erase(_order.pop_front())
	return tex
