[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/hand_view.gd" id="1_hand"]

[node name="Hand" type="VBoxContainer"]
offset_right = 900.0
offset_bottom = 170.0
theme_override_constants/separation = 6
script = ExtResource("1_hand")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="HandTitle" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CounterName"
text = "YOUR HAND · 5"

[node name="HandHint" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HandHint"
text = "Tap to pick · hold or right-click for details"
horizontal_alignment = 2

[node name="HandScroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 3

[node name="HandCards" type="HFlowContainer" parent="HandScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
alignment = 1
