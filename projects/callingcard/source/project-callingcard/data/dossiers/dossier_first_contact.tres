[resource]
script = ExtResource("1_dossier_data")
id = &"dossier_first_contact"
number = 1
display_name = "First Contact"
teaches = "Capture, facing values"
briefing = "Top faces up, Side faces left and right, Bottom faces down.
A higher facing number captures. Ties do nothing.
Capture 3 rival cards with your 2 cards."
hint = "Glacier hits hard up and down but has a weak Side. Frostbite is the opposite."
board = Array[ExtResource("2_dossier_plac")]([SubResource("Resource_p1"), SubResource("Resource_p2"), SubResource("Resource_p3")])
player_hand = Array[ExtResource("6_card_data")]([ExtResource("7_glacier"), ExtResource("8_frostbite")])
rival_replies = Array[ExtResource("2_dossier_plac")]([])
goal = 0
goal_count = 3
max_placements = 2
solution = Array[ExtResource("2_dossier_plac")]([SubResource("Resource_p4"), SubResource("Resource_p5")])
reward_card = ExtResource("9_mayday")
reward_title = "Contact Made"
reward_frame = &""
