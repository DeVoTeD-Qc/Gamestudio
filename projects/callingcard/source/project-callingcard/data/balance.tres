[ext_resource type="Resource" path="res://data/cards/mayday.tres" id="7_mayday"]

[resource]
script = ExtResource("1_balance_conf")
id = &"balance"
wall_rows = PackedInt32Array(3, 4, 3)
lineup_size = 5
clearance_cap = 12
max_legends = 1
stat_budgets = PackedInt32Array(13, 15, 17, 19)
stat_min = 1
stat_max = 9
set_size_min = 2
set_size_max = 6
set_link_bonus = 1
clutch_bonus = 2
ambush_spring_bonus = 1
signature_value = 2
triptych_bonus = 1
tie_winner = 0
chain_captures = false
cipher_code = PackedInt32Array(1, 2, 3, 4)
loaner_lineup = Array[ExtResource("2_card_data")]([ExtResource("3_graveyard_sh"), ExtResource("4_neon_rain"), ExtResource("5_last_train"), ExtResource("6_snow_blind"), ExtResource("7_mayday")])
loaner_signature = ExtResource("6_snow_blind")
