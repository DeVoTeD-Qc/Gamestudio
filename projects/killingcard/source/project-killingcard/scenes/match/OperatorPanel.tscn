[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/operator_panel.gd" id="1_op"]
[ext_resource type="PackedScene" path="res://scenes/fx/StreakArc.tscn" id="2_arc"]

[node name="OperatorPanel" type="PanelContainer"]
theme_type_variation = &"HudPanelDark"
script = ExtResource("1_op")

[node name="Row" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Info" type="VBoxContainer" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2

[node name="CaptionLabel" type="Label" parent="Row/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudSubtle"
text = "OPERATOR"

[node name="NameLabel" type="Label" parent="Row/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudHeader"
text = "OPERATOR"
clip_text = true

[node name="StatsLabel" type="Label" parent="Row/Info" groups=["key_number"]]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudNumber"
text = "FP 0  AR 0/0"

[node name="StreakRow" type="HBoxContainer" parent="Row/Info"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="StreakCaption" type="Label" parent="Row/Info/StreakRow"]
layout_mode = 2
theme_type_variation = &"HudSubtle"
text = "STREAK"

[node name="StreakValue" type="Label" parent="Row/Info/StreakRow" groups=["key_number"]]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StreakLabel"
text = "0"

[node name="StreakArc" parent="Row/Info/StreakRow" instance=ExtResource("2_arc")]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4

[node name="PerkRow" type="HBoxContainer" parent="Row/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="PerkCaption" type="Label" parent="Row/Info/PerkRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HudSubtle"
text = "PERKS"

[node name="Buttons" type="GridContainer" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6
columns = 3
