[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_pause"]

[node name="PauseMenu" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_pause")

[node name="Scrim" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"Scrim"

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Box" type="PanelContainer" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudPanelDark"

[node name="Column" type="VBoxContainer" parent="Center/Box"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PauseTitle" type="Label" parent="Center/Box/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudHeader"
text = "PAUSED"
horizontal_alignment = 1

[node name="PauseHint" type="Label" parent="Center/Box/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_type_variation = &"HudSubtle"
text = "Your run is saved."
horizontal_alignment = 1
autowrap_mode = 3

[node name="MainButtons" type="VBoxContainer" parent="Center/Box/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="ResumeButton" type="Button" parent="Center/Box/Column/MainButtons" groups=["tap_target"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 64)
layout_mode = 2
theme_type_variation = &"ReadyButton"
text = "RESUME"

[node name="FastButton" type="Button" parent="Center/Box/Column/MainButtons" groups=["tap_target"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 64)
layout_mode = 2
theme_type_variation = &"HudButton"
toggle_mode = true
text = "FAST ANIMATIONS: OFF"

[node name="ForfeitButton" type="Button" parent="Center/Box/Column/MainButtons" groups=["tap_target"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 64)
layout_mode = 2
theme_type_variation = &"HudButton"
text = "FORFEIT MATCH"

[node name="QuitButton" type="Button" parent="Center/Box/Column/MainButtons" groups=["tap_target"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 64)
layout_mode = 2
theme_type_variation = &"HudButton"
text = "QUIT TO TITLE"

[node name="ConfirmBox" type="VBoxContainer" parent="Center/Box/Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="ConfirmHint" type="Label" parent="Center/Box/Column/ConfirmBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_type_variation = &"HudHeader"
text = "Forfeit? It counts as a loss."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Row" type="HBoxContainer" parent="Center/Box/Column/ConfirmBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 8

[node name="ForfeitNoButton" type="Button" parent="Center/Box/Column/ConfirmBox/Row" groups=["tap_target"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(196, 64)
layout_mode = 2
theme_type_variation = &"HudButton"
text = "KEEP PLAYING"

[node name="ForfeitYesButton" type="Button" parent="Center/Box/Column/ConfirmBox/Row" groups=["tap_target"]]
unique_name_in_owner = true
custom_minimum_size = Vector2(196, 64)
layout_mode = 2
theme_type_variation = &"KillstreakButton"
text = "FORFEIT"
