[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/minimap.gd" id="1_minimap"]

[node name="Minimap" type="PanelContainer"]
theme_type_variation = &"HudPanelDark"
script = ExtResource("1_minimap")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Head" type="HBoxContainer" parent="Column"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Column/Head"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HudSubtle"
text = "RIVAL HAND"
vertical_alignment = 1

[node name="RivalHand" type="Label" parent="Column/Head" groups=["key_number"]]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudNumber"
text = "0"

[node name="Cells" type="HBoxContainer" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4
