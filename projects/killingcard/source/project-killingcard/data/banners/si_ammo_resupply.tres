[ext_resource type="Script" path="res://scripts/data/banner_art.gd" id="1_bart"]

[resource]
script = ExtResource("1_bart")
id = &"si_ammo_resupply"
title = "Standard Issue"
card_id = &"ammo_resupply"
image_path = "res://assets/sprites/banners/kc_b_si_ammo_resupply_art.webp"
banner_y = 0.50
portrait_x = 0.50
is_default = true
artist = "KillingCard studio (DA art pack 1)"
licence = "studio-owned"
source_note = "DA art pack 1 #2 (kc-da-import1): the plain Standard Issue painting (one open ammo box, Port dusk), replacing the soldier placeholder. The file is not named kc_b_si_ammo_resupply so UiKit.piece does not try to load the keep-imported WebP as a kit texture. Never licensed MW3 art."
