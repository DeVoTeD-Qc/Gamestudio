# balance.json mirrors the v4 sim's CONFIG (tools/sim_deaddraw_v4.py, regenerated by
# tools/regen_balance.py); the loader accepts a pasted Python dict; the rules read those numbers.
extends "res://tests/dd_test_case.gd"


func _sim_path() -> String:
	var root: String = ProjectSettings.globalize_path("res://")
	for rel: String in ["../../tools/sim_deaddraw_v4.py", "../../../tools/sim_deaddraw_v4.py"]:
		var p: String = root.path_join(rel).simplify_path()
		if FileAccess.file_exists(p):
			return p
	return ""


func _sim_config_text() -> String:
	var p: String = _sim_path()
	if p == "":
		return ""
	var src: String = FileAccess.get_file_as_string(p)
	var a: int = src.find("CONFIG = {")
	if a < 0:
		return ""
	var b: int = src.find("\n}\n", a)
	return src.substr(a, b - a + 2)


func test_balance_loads() -> void:
	var b: DDBalance = DDBalance.from_file(DDBalance.DEFAULT_PATH)
	eq(b.load_error, "", "no load error")
	eq(int(b.config.get("_version", 0)), 4, "v4 balance file")
	eq(b.district_count(), 3, "3 districts")
	for di: int in 3:
		eq(b.wave_count(di), 3, "3 waves in district %d" % di)
		eq(b.rooms(di).size(), 3, "3 rooms in district %d" % di)
	eq(b.num("street_size"), 4, "deal 4 (K4)")
	eq(b.num("actions"), 3, "resolve 3 (K4)")
	check(b.flag("points_on_kill"), "K1: points on every kill")
	eq(b.fnum("melee_points"), 0.0, "K2: melee pays nothing")
	check(b.flag("allow_run"), "K3: Run kept")
	eq(b.weapons().size(), 11, "11 guns (v4: + launcher, sweeper)")
	eq(b.shown(5), 50, "points shown x10")


func test_python_dict_paste_is_accepted() -> void:
	var src: String = "CONFIG = {\n  \"street_size\": 5,  # comment, with: punctuation\n  \"allow_run\": False,\n  'mode': 'top',\n  \"perks\": [\"a\", \"b\",],\n  \"x\": None,\n}\n"
	var b: DDBalance = DDBalance.from_text(src)
	eq(b.load_error, "", "parsed")
	eq(b.num("street_size"), 5, "number")
	check(not b.flag("allow_run"), "False -> false")
	eq(b.text("mode"), "top", "single quotes")
	eq(b.config["perks"], ["a", "b"], "trailing comma dropped")
	eq(b.rule("points_display_mult"), 10, "missing extra_rules fall back to defaults")
	eq(b.num("actions"), 3, "missing CONFIG keys fall back to sim defaults")


func test_balance_json_matches_sim_config() -> void:
	var text: String = _sim_config_text()
	check(text != "", "found tools/sim_deaddraw_v4.py CONFIG next to the project")
	if text == "":
		return
	var sim: DDBalance = DDBalance.from_text(text)
	eq(sim.load_error, "", "sim CONFIG parses")
	var ours: DDBalance = DDBalance.from_file(DDBalance.DEFAULT_PATH)
	for k: String in sim.config:
		if k == "extra_rules" or not text.contains("\"%s\"" % k):
			continue
		check(ours.config.has(k), "balance.json has " + k)
		eq(JSON.stringify(ours.config.get(k)), JSON.stringify(sim.config[k]), "CONFIG[%s] mirrors the sim" % k)


func test_rules_use_the_tuned_numbers() -> void:
	var b: DDBalance = bal()
	eq(b.num("finish_bonus"), 5, "dd-v3-tune: finish bonus 5")
	eq(b.fnum("ditch_share"), 0.0, "dd-v3-tune: an early swap pays nothing")
	eq(b.weapon_price("crossbow"), 15, "Wall Rack crossbow 15")
	eq(b.weapon_price("shotgun"), 20, "Wall Rack shotgun 20")
	eq(b.weapon_price("elephant"), 24, "Wall Rack elephant 24")
	eq([b.room_cost(0, 0), b.room_cost(0, 1), b.room_cost(0, 2)], [21, 31, 43], "Maple Row rooms")
	eq([b.room_cost(1, 0), b.room_cost(1, 1), b.room_cost(1, 2)], [27, 35, 49], "Downtown rooms")
	eq([b.room_cost(2, 0), b.room_cost(2, 1), b.room_cost(2, 2)], [28, 39, 53], "St. Agnes rooms")
	eq(b.survivor_hp("imani"), 18, "v4: Imani 18 HP")
	var r: DDRun = make_run("rosa")
	eq(r.make_gun("rifle").power, int(b.weapon_def("rifle")["p"]), "guns from CONFIG")
	eq(r.melee_power(), b.num("hands_power"), "bare-hands power from CONFIG")
	eq(str(b.survivor("theo").get("role", "")), "Courier", "display info merged from extra_rules")


func test_v4_keys_and_defaults() -> void:
	var b: DDBalance = bal()
	eq(b.text("swap_salvage"), "per_kill", "Q2: Salvage per kill")
	eq(b.num("salvage_per_kill"), 1, "+1 per kill (+10 on screen)")
	eq(b.text("carry_mode"), "shop", "Q1: Safehouse Shop")
	eq(b.shown(b.num("carry_heal_rate")), 30, "30 points per HP on screen")
	eq(b.text("melee_mode"), "hands", "bare hands")
	eq(b.num("hands_power"), 1, "bare hands power 1")
	eq(b.fnum("melee_weapon_points"), 0.0, "Q4: melee weapon kills score nothing")
	eq(b.fnum("melee_points"), 0.0, "bare-hands kills score nothing")
	eq(b.text("brawler_mode"), "hands", "Brawler on bare hands only")
	check(b.num("medkits_per_street") >= 99, "no medkit-per-street limit")
	eq(b.text("run_mode"), "anytime", "Q5: Run whenever the street has cards")
	eq(b.text("run_return"), "bottom", "Q5: Run sends the cards to the bottom")
	eq([b.melee_power("wrench"), b.melee_uses("wrench")], [3, 4], "Pipe Wrench 3 / 4 uses")
	eq([b.melee_power("axe"), b.melee_uses("axe")], [4, 3], "Fire Axe 4 / 3 uses")
	eq([b.melee_power("sledge"), b.melee_uses("sledge")], [6, 2], "Sledgehammer 6 / 2 uses")
	eq([b.weapon_power("launcher"), b.weapon_cap("launcher"), b.weapon_rule("launcher")], [7, 1, "heavy"], "Q3: launcher power 7, one shot")
	eq([b.weapon_power("sweeper"), b.weapon_cap("sweeper"), b.weapon_rule("sweeper")], [3, 4, "small"], "Alley Sweeper 3 / 4, small")
	eq(b.melee_pool(0), ["wrench"] as Array[String], "Maple Row melee pool")
	eq(b.melee_pool(2), ["axe", "sledge"] as Array[String], "St. Agnes melee pool")
	check(b.district_pool(0).has("sweeper") and not b.district_pool(0).has("launcher"), "Maple Row: sweeper, no launcher")
	check(b.district_pool(1).has("sweeper") and b.district_pool(1).has("launcher"), "Downtown: sweeper + launcher")
	check(b.district_pool(2).has("launcher") and not b.district_pool(2).has("sweeper"), "St. Agnes: launcher")
	for di: int in 3:
		check(b.entrance_spec(di).has("K"), "a melee weapon card in Entrance %d" % di)
		check(b.wave_spec(di, 1).has("K") and not b.wave_spec(di, 0).has("K") and not b.wave_spec(di, 2).has("K"), "a melee card in Wave 2 only, district %d" % di)
	eq(b.patches().size(), 14, "14 Patches")
	for p: String in ["lockpick", "iron_stomach", "adrenaline", "grudge", "show_off", "whetstone"]:
		check(b.patches().has(p), "Patch " + p)
		check(DDText.patch_text(p, b) != "" and DDText.PATCH_NAMES.has(p), "name and text for " + p)
	var d: DDBalance = DDBalance.from_text("{}")
	eq(d.num("finish_bonus"), 5, "fallback finish bonus fixed (3 -> 5)")
	eq(d.num("medkits_per_street"), 99, "fallback: no medkit limit")
