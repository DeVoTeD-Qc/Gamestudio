# art_icons.gd
# Purpose: Runtime access to the CardZone marks (cz16), adapted from CallingCard's ArtIcons:
#   59 stencil icons on a 24 grid (art-direction.md section 5), 26 gear silhouettes "sil_*" on a 96 x 40
#   grid (section 6) and 7 area glyphs "area_*" on a 48 x 48 grid (section 4). The SVG text lives in
#   art_icon_data.gd (generated by tests/tools/gen_art_icons.py, which also writes assets/icons/*.svg).
#   Icons and silhouettes are white: tint them with modulate / draw_texture_rect(..., modulate).
#   Area glyphs are in basalt + rust; get_icon(..., recolor) swaps hex colours (gassed state).
#   Marks are rasterised at the pixel size they are shown (bucketed), so they stay crisp at 3x.
# Usage:
#   CzIcons.get_icon(&"gas", 32)                   # Texture2D about 32 px square
#   CzIcons.silhouette(&"pump_shotgun", 160)        # 96:40 texture about 160 px wide
#   CzIcons.area_glyph(&"docks", 64, true)          # gassed (darkened, desaturated) colours
#   CzIcons.icon_names() / silhouette_names() / area_names()
# Dependencies: art_icon_data.gd, CzArtKit
# Author: Technical Artist Agent (cz16)
class_name CzIcons
extends RefCounted

const Data: GDScript = preload("res://scripts/art/art_icon_data.gd")
const MAX_CACHE: int = 160
const ICON_GRID: int = 24
const SIL_SIZE := Vector2i(96, 40)
const AREA_GRID: int = 48

static var _cache: Dictionary = {}
static var _order: Array = []


static func icon_names() -> Array[StringName]:
	return Data.ICON_NAMES


static func silhouette_names() -> Array[StringName]:
	return Data.SILHOUETTE_NAMES


static func area_names() -> Array[StringName]:
	return Data.AREA_NAMES


static func has_icon(icon: StringName) -> bool:
	return Data.SVG.has(icon)


static func has_silhouette(sil: StringName) -> bool:
	return Data.SVG.has(StringName("sil_" + String(sil)))


## Icon about px pixels square (bucketed to 8 px, 16..256).
static func get_icon(icon: StringName, px: float, recolor: Dictionary = {}) -> Texture2D:
	if not Data.SVG.has(icon):
		return null
	var grid: int = _grid_width(icon)
	var size: int = clampi(int(ceilf(px / 8.0)) * 8, 16, 512)
	return _raster(icon, float(size) / float(grid), recolor)


## Silhouette texture about px pixels wide (96:40 aspect).
static func silhouette(sil: StringName, px: float) -> Texture2D:
	return get_icon(StringName("sil_" + String(sil)), px)


## Area glyph (48 grid) for an area id (docks, farmstead, quarry, radio_hill, motel, rail_yard, old_town).
static func area_glyph(area_id: StringName, px: float, gassed: bool = false) -> Texture2D:
	var key := StringName("area_" + String(area_id))
	if not gassed:
		return get_icon(key, px)
	var swap: Dictionary = {}
	for c: Color in [CzArtKit.BASALT, CzArtKit.RUST, CzArtKit.SCRUB, CzArtKit.SHOAL, CzArtKit.DUNE]:
		swap["#" + c.to_html(false).to_upper()] = "#" + CzArtKit.gas_tone(c).to_html(false).to_upper()
	return get_icon(key, px, swap)


static func _grid_width(icon: StringName) -> int:
	var s: String = String(icon)
	if s.begins_with("sil_"):
		return SIL_SIZE.x
	if s.begins_with("area_"):
		return AREA_GRID
	return ICON_GRID


static func _raster(icon: StringName, scale: float, recolor: Dictionary) -> Texture2D:
	var key: String = "%s@%.3f%s" % [icon, scale, str(recolor.hash()) if not recolor.is_empty() else ""]
	if _cache.has(key):
		return _cache[key]
	var text: String = Data.SVG[icon]
	for from: String in recolor:
		text = text.replace(from, String(recolor[from]))
	var img := Image.new()
	if img.load_svg_from_string(text, scale) != OK:
		push_warning("CzIcons: could not rasterise %s" % icon)
		return null
	img.generate_mipmaps()
	var tex := ImageTexture.create_from_image(img)
	_cache[key] = tex
	_order.append(key)
	while _order.size() > MAX_CACHE:
		_cache.erase(_order.pop_front())
	return tex
