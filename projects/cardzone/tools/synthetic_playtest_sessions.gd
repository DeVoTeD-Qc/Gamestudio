# synthetic_playtest_sessions.gd
# Adapted from CallingCard tools/synthetic_playtest_sessions.gd (personas, export wrapping).
# Purpose: cz18 helper. Produces SYNTHETIC playtest exports for testing tools/kpi_sheet.py. It runs
#   real matches headless on the rules engine through MatchController (CzAI as the opponent, a CzAI
#   bot playing the human's seat through request()), with the real PlaytestLog autoload listening
#   to EventBus, for differing personas:
#     A  iPhone, 3 matches (Rookie, then Veteran twice), quick packer, coach seen, a reload in
#        match 2 resumed in a second session, survey answered, Download log
#     B  desktop, 2 matches, slow packer, concedes the second, survey answered
#     C  iPhone, partial: 1 match, slow load, survey skipped, no quit line (tab hidden)
#   plus an empty export (D: consent off, the logger writes nothing).
#   These are NOT player data. Two things are simulated and the export says so:
#     - time: the logger's clock is a fake one the driver moves (think time per human action,
#       Pack time, 0.45 s per announced event as the screen paces them);
#     - device: a headless run reports a desktop with no browser, so session_start's device fields
#       and load_ms are patched per persona after export.
#   Every export gets top-level "synthetic": true, and the files are named SYNTHETIC-*.json.
#   tools/kpi_sheet.py leaves synthetic files out unless --include-synthetic is passed.
#
# Usage (from source/project-cardzone; needs no game code change):
#   godot --headless --path . -s ../../tools/synthetic_playtest_sessions.gd -- --out=<dir>
#   (the absolute path of this file also works for -s)
# Writes nothing to the real log or save: the logger is pointed at user://synthetic_playtest/
#   (deleted afterwards) and the controller's saving is off.
# Author: Data Scientist Agent
extends SceneTree

const CONTROLLER_PATH: String = "res://scripts/match/match_controller.gd"
const WORK_DIR: String = "user://synthetic_playtest"
const NOTE: String = "SYNTHETIC: generated by tools/synthetic_playtest_sessions.gd from real headless matches (CzAI on both seats) through the real PlaytestLog. Time is a simulated clock; session_start device fields and load_ms are patched per persona. Not player data."

var plog: Node
var bus: Node
var out_dir: String = ""
var fake_ms: int = 1000
var rng: RandomNumberGenerator = RandomNumberGenerator.new()
## Loaded at run time: autoload names (CardDB, ...) only exist once the tree is up.
var controller_script: GDScript


func _initialize() -> void:
	_run.call_deferred()


func _run() -> void:
	await process_frame
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--out="):
			out_dir = arg.trim_prefix("--out=")
	if out_dir == "":
		push_error("pass -- --out=<directory>")
		quit(2)
		return
	DirAccess.make_dir_recursive_absolute(out_dir)
	controller_script = load(CONTROLLER_PATH)
	plog = root.get_node("PlaytestLog")
	bus = root.get_node("EventBus")
	plog.clock = func() -> int: return fake_ms
	plog.show_title_button = false
	bus.rules_event.connect(func(_e: Dictionary) -> void: fake_ms += 450)
	var written: Array[String] = []
	written.append(await _persona("A-iphone-three-matches", _persona_a, {"device_class": "phone", "mobile": true,
			"touchscreen": true, "input_type": "touch", "web": true, "browser": "safari", "os_family": "ios",
			"viewport": [1168, 540], "window_px": [2532, 1170], "pixel_ratio": 3.0, "load_ms": 6200}, 101))
	written.append(await _persona("B-desktop-slow-packer", _persona_b, {"device_class": "desktop", "mobile": false,
			"touchscreen": false, "input_type": "mouse", "web": true, "browser": "chrome", "os_family": "windows",
			"viewport": [1280, 720], "window_px": [1920, 1080], "pixel_ratio": 1.5, "load_ms": 3100}, 202))
	written.append(await _persona("C-iphone-partial", _persona_c, {"device_class": "phone", "mobile": true,
			"touchscreen": true, "input_type": "touch", "web": true, "browser": "safari", "os_family": "ios",
			"viewport": [1168, 540], "window_px": [2532, 1170], "pixel_ratio": 3.0, "load_ms": 12400}, 303))
	written.append(_empty_export())
	for f: String in written:
		print("wrote %s" % f)
	for f: String in DirAccess.get_files_at(WORK_DIR):
		DirAccess.remove_absolute(WORK_DIR.path_join(f))
	DirAccess.remove_absolute(WORK_DIR)
	quit(0)


## One persona: a fresh log on this "device", the driver, then the export (patched, wrapped).
func _persona(tag: String, driver: Callable, device: Dictionary, seed_value: int) -> String:
	DirAccess.make_dir_recursive_absolute(WORK_DIR)
	plog.log_path = WORK_DIR.path_join("%s.jsonl" % tag)
	plog.consent_path = WORK_DIR.path_join("%s_consent.cfg" % tag)
	plog.delete_log()
	plog.enabled = false
	plog.survey_answers = {}
	rng.seed = seed_value
	fake_ms = 1000
	plog.new_session()
	plog.set_consent(true, false)
	await driver.call()
	plog.flush()
	var doc: Dictionary = JSON.parse_string(plog.build_export())
	for e: Dictionary in doc["events"]:
		if e["event"] == "session_start":
			for k: String in device:
				e[k] = device[k]
	doc["synthetic"] = true
	doc["synthetic_note"] = NOTE
	var path: String = out_dir.path_join("SYNTHETIC-%s.json" % tag)
	var f: FileAccess = FileAccess.open(path, FileAccess.WRITE)
	f.store_string(JSON.stringify(doc, "  ", false))
	f.close()
	plog.enabled = false
	plog.delete_log()
	return path


func _empty_export() -> String:
	DirAccess.make_dir_recursive_absolute(WORK_DIR)
	plog.log_path = WORK_DIR.path_join("D.jsonl")
	plog.delete_log()
	plog.enabled = false
	plog.new_session()
	var doc: Dictionary = JSON.parse_string(plog.build_export())
	doc["synthetic"] = true
	doc["synthetic_note"] = NOTE + " Consent off: the logger wrote nothing."
	var path: String = out_dir.path_join("SYNTHETIC-D-consent-off-empty.json")
	var f: FileAccess = FileAccess.open(path, FileAccess.WRITE)
	f.store_string(JSON.stringify(doc, "  ", false))
	f.close()
	return path


func _controller(level: StringName, seed_value: int) -> Node:
	var ctrl: Node = controller_script.new()
	ctrl.event_delay = 0.0
	ctrl.opponent_delay = 0.0
	ctrl.save_enabled = false
	ctrl.opponent = _ai(level, seed_value)
	ctrl.meta = {"mode": "ai", "ai_level": String(level), "ai_seed": seed_value, "human_seat": 0}
	root.add_child(ctrl)
	return ctrl


## Plays the human's seat with `bot` until the match ends, or until stop_after human actions.
## think_s: [min, max] seconds per action; pack_s: [min, max] from the Pack step to End turn.
func _play(ctrl: Node, bot: Variant, think_s: Vector2, pack_s: Vector2, stop_after: int = -1, concede_after: int = -1) -> void:
	var sent: int = 0
	while not ctrl.state.is_over():
		if stop_after >= 0 and sent >= stop_after:
			return
		if concede_after >= 0 and sent >= concede_after:
			ctrl.request({"type": "concede"})
			return
		if not ctrl.is_human_turn():
			await process_frame
			continue
		var a: Dictionary = bot.choose_action(ctrl.state, ctrl.human)
		if a.is_empty() or ctrl.why_not(a) != "":
			var legal: Array = ctrl.legal()
			if legal.is_empty():
				return
			a = legal[0]
		fake_ms += int(rng.randf_range(think_s.x, think_s.y) * 1000.0)
		if a["type"] == "end_turn":
			plog.mark_pack_step()
			fake_ms += int(rng.randf_range(pack_s.x, pack_s.y) * 1000.0)
		ctrl.request(a)
		sent += 1


## CzAI for a level (looked up at run time, like the controller).
func _ai(level: StringName, seed_value: int) -> RefCounted:
	var cls: Variant = load("res://scripts/ai/cz_ai.gd")
	return (cls as GDScript).call("for_level", level, seed_value)


func _screen(id: StringName) -> void:
	bus.screen_shown.emit(id)
	fake_ms += 1500


func _persona_a() -> void:
	_screen(&"title")
	_screen(&"match")
	for step: StringName in [&"hold", &"brace", &"down", &"adrenaline"]:
		bus.coach_step.emit(step, false)
		fake_ms += 4000
	var bot: Variant = _ai(&"veteran", 11)
	var ctrl: Node = _controller(&"rookie", 1)
	ctrl.start_new(0)
	await _play(ctrl, bot, Vector2(3, 9), Vector2(3, 9))
	_screen(&"title")
	_screen(&"match")
	ctrl.opponent = _ai(&"veteran", 2)
	ctrl.meta["ai_level"] = "veteran"
	ctrl.start_new(1)
	await _play(ctrl, bot, Vector2(3, 9), Vector2(3, 10), 30)
	# Phone locked / page reloaded mid-match: the tab hides, a new launch resumes the save.
	var saved: Variant = ctrl.state.clone()
	plog.log_event(&"app_hidden", {"screen": "match", "session_s": (fake_ms - plog.session_started_ms) / 1000.0})
	plog.flush()
	fake_ms += 240000
	plog.enabled = false
	plog.new_session()
	plog.set_consent(true, false)
	_screen(&"title")
	_screen(&"match")
	ctrl.start_resumed({"state": saved, "meta": ctrl.meta.duplicate(),
			"saved_at": int(Time.get_unix_time_from_system()) - 240})
	await _play(ctrl, bot, Vector2(3, 9), Vector2(3, 10))
	ctrl.start_new(2)  # PLAY AGAIN from the end screen
	await _play(ctrl, bot, Vector2(3, 8), Vector2(2, 8))
	ctrl.queue_free()
	_screen(&"title")
	_screen(&"survey")
	plog.record_survey({"q1": 5, "q2": 4, "q3": 4, "q4": 4, "q5": 5, "open": "Holding a vest for the AI's turn felt smart."})
	plog.export_log()
	plog._on_quit("pagehide")


func _persona_b() -> void:
	_screen(&"title")
	_screen(&"match")
	bus.coach_step.emit(&"hold", false)
	bus.coach_step.emit(&"brace", true)
	var bot: Variant = _ai(&"rookie", 21)
	var ctrl: Node = _controller(&"rookie", 3)
	ctrl.start_new(0)
	await _play(ctrl, bot, Vector2(6, 20), Vector2(12, 32))
	_screen(&"title")
	_screen(&"match")
	ctrl.opponent = _ai(&"veteran", 4)
	ctrl.meta["ai_level"] = "veteran"
	ctrl.start_new(1)
	await _play(ctrl, bot, Vector2(6, 20), Vector2(12, 32), -1, 40)
	ctrl.queue_free()
	_screen(&"title")
	_screen(&"survey")
	plog.record_survey({"q1": 3, "q2": 2, "q3": 2, "q4": 4, "q5": 4, "open": ""})
	plog.export_log()
	plog._on_quit("close")


func _persona_c() -> void:
	_screen(&"title")
	_screen(&"match")
	bus.coach_step.emit(&"hold", true)
	var bot: Variant = _ai(&"rookie", 31)
	var ctrl: Node = _controller(&"rookie", 5)
	ctrl.start_new(2)
	await _play(ctrl, bot, Vector2(5, 15), Vector2(5, 18))
	ctrl.queue_free()
	_screen(&"title")
	_screen(&"survey")
	plog.record_survey({"open": ""})
	plog.export_log()
	plog.log_event(&"app_hidden", {"screen": "survey", "session_s": (fake_ms - plog.session_started_ms) / 1000.0})
